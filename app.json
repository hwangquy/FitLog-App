{
  "expo": {
    "name": "FitLog",
    "slug": "fitlog-mobile",
    "scheme": "fitlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép FitLog ghi nhận vị trí buổi tập khi bạn đồng ý."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép FitLog chọn ảnh buổi tập khi bạn đồng ý."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "workout-reminders"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "vn.fitlog.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "vn.fitlog.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1806efad-ea27-4229-877f-542a40b36467"
      }
    }
  }
}
