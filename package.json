{
  "name": "fitlog-mobile",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "json-server --watch db.json --host 0.0.0.0 --port 3001",
    "ai-proxy": "node server/ai-proxy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/register.mjs --test \"tests/*.test.ts\"",
    "validate:db": "node --experimental-strip-types --import ./tests/register.mjs scripts/validate-db.mjs",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "^2.9.0",
    "@tamagui/config": "^1.125.0",
    "@tamagui/core": "^1.125.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.27",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.2.0",
    "tamagui": "^1.125.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "json-server": "0.17.4",
    "typescript": "~6.0.3"
  }
}
